# Lab network
LAB_NET_NAME=lab-net
LAB_NET_SUBNET=192.168.77.0
LAB_NET_NETMASK=255.255.255.0
LAB_NET_GATEWAY=192.168.77.1
LAB_NET_DHCP_START=192.168.77.100
LAB_NET_DHCP_END=192.168.77.200

# Storage
VM_STORAGE_DIR=/var/lib/libvirt/images

# ISO paths (chỉnh theo máy của bạn)
WS_ISO=/var/lib/libvirt/boot/windows-server.iso
WIN7_ISO=/var/lib/libvirt/boot/windows-7.iso

# VM specs
WS_NAME=ws01
WS_VCPUS=4
WS_RAM_MB=8192
WS_DISK_GB=80

WIN7_1_NAME=win7-01
WIN7_1_VCPUS=2
WIN7_1_RAM_MB=4096
WIN7_1_DISK_GB=40

WIN7_2_NAME=win7-02
WIN7_2_VCPUS=2
WIN7_2_RAM_MB=4096
WIN7_2_DISK_GB=40
